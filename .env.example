NODE_ENV=development
PORT=3100
DATABASE_PATH=./data/stam.sqlite
PUBLIC_ORIGIN=http://localhost:5174
# Production generates a persistent secret beside the database when neither
# AUTH_SECRET nor AUTH_SECRET_FILE is set. Uncomment one to manage it externally.
# AUTH_SECRET=replace-with-at-least-32-random-characters
# AUTH_SECRET_FILE=/run/secrets/stam_auth_secret
WEBAUTHN_RP_ID=localhost
# Container image tag used by Compose; prefer an exact release in production.
STAM_VERSION=edge
# Used only by `bun run auth:bootstrap`.
STAM_ADMIN_EMAIL=admin@example.com
STAM_ADMIN_NAME=Administrator
STAM_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
# Used only by `bun run db:backup`; each destination must be new.
STAM_BACKUP_PATH=./backups/stam.sqlite
# Used only by `bun run db:restore`; replacement still requires `--replace`.
STAM_RESTORE_PATH=./backups/stam.sqlite
# Optional transfer-integrity digest for restore verification.
STAM_RESTORE_SHA256=
